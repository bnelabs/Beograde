# Beograde runtime needs no secrets. These vars are for build-time scripts only.

# Required only when running `npm run build:images` against POIs whose curator
# files use `sourceType: "mapillary"`. Get a client token from
# https://www.mapillary.com/dashboard/developers — free tier is sufficient.
# Format: MLY|<app_id>|<token>
MAPILLARY_TOKEN=
