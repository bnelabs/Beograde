{
  "version": 8,
  "name": "Beograde Warm",
  "metadata": {
    "description": "Warm Belgrade palette — parchment land, deep Danube blue, muted olive parks, amber primary roads. Targets the OpenMapTiles schema produced by planetiler."
  },
  "glyphs": "assets/fonts/{fontstack}/{range}.pbf",
  "sprite": "",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://belgrade",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f3ead6" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#ede2c7", "fill-opacity": 0.55 }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "commercial"],
      "paint": { "fill-color": "#e5d6b3", "fill-opacity": 0.55 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#b8c89a", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#2b5d8a" }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#dccdb1",
        "fill-outline-color": "#b8a888",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 0.85]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "minzoom": 12,
      "paint": {
        "line-color": "#fbf4e3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 5]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 18, 8]
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary"],
      "paint": {
        "line-color": "#f3c989",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.6, 18, 12]
      }
    },
    {
      "id": "roads-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "trunk", "motorway"],
      "paint": {
        "line-color": "#e6a560",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 18, 16]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": { "line-color": "#a89478", "line-width": 1, "line-dasharray": [2, 2] }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 11, 16, 16]
      },
      "paint": {
        "text-color": "#3b2a17",
        "text-halo-color": "#f3ead6",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#5b432b",
        "text-halo-color": "#fbf4e3",
        "text-halo-width": 1
      }
    }
  ]
}
